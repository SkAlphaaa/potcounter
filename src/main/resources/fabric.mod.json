{
  "schemaVersion": 1,
  "id": "potioncounter",
  "version": "${version}",
  "name": "PotionCounter",
  "description": "counts the amount of noobs potting (instant health pots)",
  "authors": [
    "skalpha","uku"
  ],
  "contact": {
    "repo": "https://github.com/skalphaa/potioncounter"
  },
  "license": "MIT",
  "icon": "assets/potioncounter/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.skalpha.potioncounter.PotionCounter"
    ],
    "ukulib": [
      "com.skalpha.potioncounter.UkulibHook"
    ]
  },
  "mixins": [
    "potioncounter.mixins.json"
  ],
  "depends": {
    "minecraft": ">=1.21.11",
    "fabricloader": ">=0.17",
    "fabric-resource-loader-v1": "*",
    "fabric-command-api-v2": "*",
    "ukulib": "^1.10.0"
  }
}
